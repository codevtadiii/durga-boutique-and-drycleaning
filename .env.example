# Copy to .env for local development. Replace the placeholder before any shared or production use.
POSTGRES_DB=durga_business
POSTGRES_USER=durga_app
POSTGRES_PASSWORD=local-development-only

DATABASE_URL=postgresql+psycopg://durga_app:local-development-only@db:5432/durga_business
SESSION_SECRET=replace-with-a-random-secret-before-use
BUSINESS_TIMEZONE=Asia/Kolkata
MEDIA_ROOT=/data/media
API_INTERNAL_URL=http://api:8000
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30
AUTO_CREATE_SCHEMA=true

# Optional shop number for staff-created click-to-chat drafts. Leave blank to disable drafts.
SHOP_WHATSAPP_NUMBER=
